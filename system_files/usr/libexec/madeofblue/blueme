#!/usr/bin/env bash
# Set up a fresh MadeOfBlue install:
#   ujust blueme           run all steps (WireGuard VPN -> AI agent -> dotfiles)
#   ujust blueme vpn       configure the home WireGuard VPN in NetworkManager
#   ujust blueme agent     configure the Noctalia AI agent (defaults to aipro.lan)
#   ujust blueme dotfiles  clone and bootstrap github.com/bugthing/dotfiles

set -euo pipefail

DEFAULT_AGENT_HOST="http://aipro.lan:11435/v1"
DOTFILES_BOOTSTRAP_URL="https://raw.githubusercontent.com/bugthing/dotfiles/main/bootstrap"
AGENT_DATA_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/plugins/data/madeofblue/agent"
AGENT_CONFIG="$AGENT_DATA_DIR/config.json"

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

log() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() {
	printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
	exit 1
}

ask() {
	local prompt="$1" default="${2:-}" reply=""
	if [ -n "$default" ]; then
		read -rp "$prompt [$default]: " reply
		printf '%s' "${reply:-$default}"
	else
		read -rp "$prompt: " reply
		printf '%s' "$reply"
	fi
}

confirm() {
	local prompt="$1" default="${2:-Y}" hint="[Y/n]" reply=""
	[ "$default" = "N" ] && hint="[y/N]"
	read -rp "$prompt $hint " reply
	reply="${reply:-$default}"
	[[ "$reply" =~ ^[Yy] ]]
}

# --- Bitwarden CLI helper ---------------------------------------------------

ensure_bw() {
	if ! command -v bw >/dev/null 2>&1; then
		if command -v brew >/dev/null 2>&1 && confirm "Bitwarden CLI (bw) is not installed. Install it via Homebrew?" "Y"; then
			brew install bitwarden-cli
		else
			warn "bw is not installed; install it with 'brew install bitwarden-cli' or use the Bitwarden desktop app."
			return 1
		fi
	fi
	local status
	status="$(bw status 2>/dev/null | jq -r '.status // "unauthenticated"')"
	if [ "$status" = "unauthenticated" ]; then
		info "Logging in to Bitwarden..."
		bw login
		status="$(bw status 2>/dev/null | jq -r '.status // "locked"')"
	fi
	if [ "$status" != "unlocked" ]; then
		info "Unlocking Bitwarden vault..."
		BW_SESSION="$(bw unlock --raw)"
		export BW_SESSION
	fi
	bw sync >/dev/null 2>&1 || true
}

# Fetch a secret or note from Bitwarden by search term.
bw_fetch() {
	local query="$1" field="${2:-secret}"
	ensure_bw || return 1
	local items count item_json
	items="$(bw list items --search "$query")"
	count="$(jq 'length' <<<"$items")"
	if [ "$count" -eq 0 ]; then
		warn "No Bitwarden items matched '$query'."
		return 1
	elif [ "$count" -eq 1 ]; then
		item_json="$(jq '.[0]' <<<"$items")"
	else
		info "Matching Bitwarden items:"
		local i=1
		while IFS= read -r name; do
			printf '  %d) %s\n' "$i" "$name" >&2
			i=$((i + 1))
		done < <(jq -r '.[].name' <<<"$items")
		local idx
		read -rp "Pick item number (1-$count): " idx
		[[ "$idx" =~ ^[0-9]+$ ]] && ((idx >= 1 && idx <= count)) || return 1
		item_json="$(jq ".[$((idx - 1))]" <<<"$items")"
	fi
	if [ "$field" = "notes" ]; then
		jq -r '.notes // .login.password // empty' <<<"$item_json"
	else
		jq -r '.login.password // (.fields[0].value) // .notes // empty' <<<"$item_json"
	fi
}

# --- Step 1: WireGuard VPN --------------------------------------------------

import_wg_conf() {
	local name="$1" content="$2"
	local tmpdir="/dev/shm"
	[ -d "$tmpdir" ] || tmpdir="/tmp"
	local tmp="$tmpdir/$name.conf"
	(
		umask 077
		printf '%s\n' "$content" >"$tmp"
	)
	trap 'rm -f "$tmp"' RETURN
	sudo nmcli connection delete "$name" >/dev/null 2>&1 || true
	sudo nmcli connection import type wireguard file "$tmp"
	if confirm "Connect to '$name' now?" "Y"; then
		nmcli connection up "$name"
	fi
}

setup_vpn() {
	log "WireGuard Home VPN"
	local existing
	existing="$(nmcli -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null | awk -F: '$2 == "wireguard" {print $1 " (active: " $3 ")"}' || true)"
	if [ -n "$existing" ]; then
		info "Existing WireGuard connection(s): $existing"
		if ! confirm "Configure or replace a WireGuard connection?" "N"; then
			return 0
		fi
	elif ! confirm "Set up a WireGuard VPN connection?" "Y"; then
		return 0
	fi

	echo
	echo "How would you like to provide the WireGuard configuration?"
	echo "  1) Enter connection details interactively (prompts for endpoint, IPs & keys)"
	echo "  2) Import an existing WireGuard .conf file"
	echo "  3) Import a WireGuard .conf from a Bitwarden item/note"
	local mode
	mode="$(ask "Choice (1-3)" "1")"

	case "$mode" in
	2)
		local path name
		path="$(ask "Path to WireGuard .conf file")"
		path="${path/#\~/$HOME}"
		[ -f "$path" ] || die "File not found: $path"
		name="$(basename "$path" .conf)"
		import_wg_conf "$name" "$(cat "$path")"
		;;
	3)
		local name query conf
		name="$(ask "Interface / connection name (max 15 chars)" "wg0")"
		query="$(ask "Bitwarden search term for your WireGuard config" "wireguard")"
		conf="$(bw_fetch "$query" notes)" || die "Could not fetch WireGuard config from Bitwarden"
		[ -n "$conf" ] || die "Bitwarden item was empty"
		import_wg_conf "$name" "$conf"
		;;
	*)
		local name endpoint address dns search allowed peer_pub priv_key psk
		name="$(ask "Interface / connection name (max 15 chars)" "wg0")"
		endpoint="$(ask "Server Endpoint (host:port, e.g. vpn.example.com:51820)")"
		[ -n "$endpoint" ] || die "Endpoint is required"
		address="$(ask "Client IPv4 CIDR (e.g. 10.8.0.2/24)")"
		[ -n "$address" ] || die "Client IPv4 CIDR is required"
		dns="$(ask "VPN DNS server (optional, e.g. 10.8.0.1)" "")"
		search=""
		if [ -n "$dns" ]; then
			search="$(ask "VPN DNS search domain (so aipro.lan resolves)" "lan")"
		fi
		allowed="$(ask "AllowedIPs (home LAN split-tunnel or 0.0.0.0/0)" "10.0.0.0/8, 192.168.0.0/16")"
		peer_pub="$(ask "Server (Peer) PublicKey")"
		[ -n "$peer_pub" ] || die "Server PublicKey is required"

		echo "Client PrivateKey: paste it, type 'bw' to fetch from Bitwarden, or press Enter to generate a new keypair."
		read -rsp "Client PrivateKey: " priv_key
		echo
		if [ "$priv_key" = "bw" ]; then
			local query
			query="$(ask "Bitwarden search term" "wireguard")"
			priv_key="$(bw_fetch "$query" secret)" || die "Could not fetch PrivateKey from Bitwarden"
		elif [ -z "$priv_key" ]; then
			priv_key="$(wg genkey)"
			info "Generated new client PublicKey (add this to your WireGuard server):"
			printf '    \033[1;32m%s\033[0m\n' "$(printf '%s' "$priv_key" | wg pubkey)"
		fi

		read -rsp "PresharedKey (optional; press Enter for none): " psk
		echo

		local dns_line="" psk_line=""
		if [ -n "$dns" ]; then
			dns_line="DNS = ${dns}${search:+, $search}"
		fi
		if [ -n "$psk" ]; then
			psk_line="PresharedKey = $psk"
		fi

		local conf
		conf="[Interface]
Address = $address
PrivateKey = $priv_key
${dns_line:+$dns_line
}
[Peer]
PublicKey = $peer_pub
${psk_line:+$psk_line
}Endpoint = $endpoint
AllowedIPs = $allowed
PersistentKeepalive = 25"
		import_wg_conf "$name" "$conf"
		;;
	esac
}

# --- Step 2: Noctalia AI Agent (aipro.lan) ----------------------------------

detect_model() {
	local host="$1" token="$2"
	local args=(-fsS --max-time 5 -H "Accept: application/json")
	if [ -n "$token" ]; then
		args+=(-H "Authorization: Bearer $token")
	fi
	curl "${args[@]}" "$host/models" 2>/dev/null |
		jq -r '.data[0].id // empty' 2>/dev/null || true
}

setup_agent() {
	log "Noctalia AI Agent"
	if [ -f "$AGENT_CONFIG" ]; then
		local cur_host cur_model
		cur_host="$(jq -r '.host // "?"' "$AGENT_CONFIG" 2>/dev/null || echo "?")"
		cur_model="$(jq -r '.model // "?"' "$AGENT_CONFIG" 2>/dev/null || echo "?")"
		info "Current config: $cur_host ($cur_model)"
		if ! confirm "Reconfigure the AI agent?" "N"; then
			return 0
		fi
	elif ! confirm "Configure the Noctalia AI agent ($DEFAULT_AGENT_HOST)?" "Y"; then
		return 0
	fi

	local host token detected model
	host="$(ask "Host URL" "$DEFAULT_AGENT_HOST")"
	host="${host%/}"

	echo "API token: paste it, type 'bw' to fetch from Bitwarden, or press Enter if not required."
	read -rsp "API token: " token
	echo
	if [ "$token" = "bw" ]; then
		local query
		query="$(ask "Bitwarden search term" "aipro")"
		token="$(bw_fetch "$query" secret)" || die "Could not fetch token from Bitwarden"
	fi

	info "Probing $host/models..."
	detected="$(detect_model "$host" "$token")"
	if [ -n "$detected" ]; then
		info "Detected model on server: $detected"
	else
		info "Could not reach $host/models right now; defaulting model name to 'local'."
		detected="local"
	fi
	model="$(ask "Model name" "$detected")"

	mkdir -p -m 0700 "$AGENT_DATA_DIR"
	(
		umask 077
		jq -n \
			--arg provider "openai" \
			--arg host "$host" \
			--arg model "$model" \
			--arg token "$token" \
			'{provider: $provider, host: $host, model: $model, token: $token}' >"$AGENT_CONFIG"
	)
	info "Saved agent config to $AGENT_CONFIG (open with Mod+A)."
}

# --- Step 3: Dotfiles & Syncthing bootstrap ---------------------------------

setup_dotfiles() {
	log "Dotfiles & Syncthing (github.com/bugthing/dotfiles)"
	if ! confirm "Run dotfiles bootstrap now?" "Y"; then
		return 0
	fi
	if [ -f "$HOME/.dotfiles/bootstrap" ]; then
		bash "$HOME/.dotfiles/bootstrap"
	else
		curl -fsSL "$DOTFILES_BOOTSTRAP_URL" | bash
	fi
}

# --- Entrypoint -------------------------------------------------------------

step="${1:-all}"
case "$step" in
all)
	setup_vpn
	setup_agent
	setup_dotfiles
	log "All done! Press Mod+A to open the agent."
	;;
vpn)
	setup_vpn
	;;
agent)
	setup_agent
	;;
dotfiles)
	setup_dotfiles
	;;
*)
	echo "usage: ujust blueme [all|vpn|agent|dotfiles]" >&2
	exit 2
	;;
esac
