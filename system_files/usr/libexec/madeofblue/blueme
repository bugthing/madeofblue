#!/usr/bin/env bash
# Set up a fresh MadeOfBlue install:
#   ujust blueme            run all steps (VPN -> AI agent -> dotfiles -> Syncthing & packages)
#   ujust blueme vpn        configure the home WireGuard VPN in NetworkManager
#   ujust blueme agent      configure the Noctalia AI agent (defaults to aipro.lan)
#   ujust blueme dotfiles   clone and stow github.com/bugthing/dotfiles into $HOME
#   ujust blueme syncthing  start Syncthing, pair by QR code, wait for sync, and link folders
#   ujust blueme packages   install Homebrew bundle, mise tools, and Neovim plugins
#
# Environment overrides:
#   DOTFILES=~/.dotfiles    where the dotfiles repo lives
#   SKIP_BREW=1             skip brew bundle
#   SKIP_MISE=1             skip mise install
#   SKIP_SYNC=1             skip Syncthing pairing and waiting (links what is already there)

set -euo pipefail

DEFAULT_AGENT_HOST="http://aipro.lan:11435/v1"
AGENT_DATA_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/plugins/data/madeofblue/agent"
AGENT_CONFIG="$AGENT_DATA_DIR/config.json"

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
REPO_HTTPS="https://github.com/bugthing/dotfiles.git"
REPO_SSH="git@github.com:bugthing/dotfiles.git"
BREW="/home/linuxbrew/.linuxbrew/bin/brew"
SYNC_ROOT="${SYNC_ROOT:-$HOME/container-volumes/syncthing}"
ST_CONFIG="$SYNC_ROOT/config/config.xml"
ST_URL="${ST_URL:-http://127.0.0.1:8384}"
STAMP="$(date +%Y%m%d-%H%M%S)"

# Stow packages linked into $HOME (per-file links, never whole directories).
STOW_PACKAGES=(bash git vim tmux ruby containers)

# Syncthing folder labels to wait for. Pairing is done by scanning a QR code,
# so no device or folder IDs are stored here. Each lands in
# ~/container-volumes/syncthing/<label>.
SYNC_FOLDERS=(HomeSync PasswordStore)

# Links from synced data into $HOME, as "path under the syncthing volume:path under $HOME".
SYNC_LINKS=(
	"HomeSync/ssh:.ssh"
	"HomeSync/gnupg:.gnupg"
	"HomeSync/scripts:scripts"
	"HomeSync/Pictures:Pictures/HomeSync"
	"HomeSync/Documents:Documents/HomeSync"
	"HomeSync/Notes:Notes"
	"PasswordStore:.password-store"
)

if [ -x "$BREW" ]; then
	eval "$("$BREW" shellenv)"
fi

log() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() {
	printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
	exit 1
}

ask() {
	local prompt="$1" default="${2:-}" reply=""
	if [ -n "$default" ]; then
		read -rp "$prompt [$default]: " reply
		printf '%s' "${reply:-$default}"
	else
		read -rp "$prompt: " reply
		printf '%s' "$reply"
	fi
}

confirm() {
	local prompt="$1" default="${2:-Y}" hint="[Y/n]" reply=""
	[ "$default" = "N" ] && hint="[y/N]"
	read -rp "$prompt $hint " reply
	reply="${reply:-$default}"
	[[ "$reply" =~ ^[Yy] ]]
}

# Ask on the terminal; with no terminal, leave the decision to the web UI.
confirm_tty() {
	local reply
	{ exec 3</dev/tty; } 2>/dev/null || return 2
	printf '%s [y/N] ' "$1" >/dev/tty
	read -r reply <&3 || reply=""
	exec 3<&-
	[[ "$reply" =~ ^[Yy] ]]
}

backup() {
	local dest="$1.pre-bootstrap-$STAMP"
	mv "$1" "$dest"
	info "Moved $1 to $dest"
}

# --- Bitwarden CLI helper ---------------------------------------------------

ensure_bw() {
	if ! command -v bw >/dev/null 2>&1; then
		if command -v brew >/dev/null 2>&1 && confirm "Bitwarden CLI (bw) is not installed. Install it via Homebrew?" "Y"; then
			brew install bitwarden-cli
		else
			warn "bw is not installed; install it with 'brew install bitwarden-cli' or use the Bitwarden desktop app."
			return 1
		fi
	fi
	local status
	status="$(bw status 2>/dev/null | jq -r '.status // "unauthenticated"')"
	if [ "$status" = "unauthenticated" ]; then
		info "Logging in to Bitwarden..."
		bw login
		status="$(bw status 2>/dev/null | jq -r '.status // "locked"')"
	fi
	if [ "$status" != "unlocked" ]; then
		info "Unlocking Bitwarden vault..."
		BW_SESSION="$(bw unlock --raw)"
		export BW_SESSION
	fi
	bw sync >/dev/null 2>&1 || true
}

# Fetch a secret or note from Bitwarden by search term.
bw_fetch() {
	local query="$1" field="${2:-secret}"
	ensure_bw || return 1
	local items count item_json
	items="$(bw list items --search "$query")"
	count="$(jq 'length' <<<"$items")"
	if [ "$count" -eq 0 ]; then
		warn "No Bitwarden items matched '$query'."
		return 1
	elif [ "$count" -eq 1 ]; then
		item_json="$(jq '.[0]' <<<"$items")"
	else
		info "Matching Bitwarden items:"
		local i=1
		while IFS= read -r name; do
			printf '  %d) %s\n' "$i" "$name" >&2
			i=$((i + 1))
		done < <(jq -r '.[].name' <<<"$items")
		local idx
		read -rp "Pick item number (1-$count): " idx
		[[ "$idx" =~ ^[0-9]+$ ]] && ((idx >= 1 && idx <= count)) || return 1
		item_json="$(jq ".[$((idx - 1))]" <<<"$items")"
	fi
	if [ "$field" = "notes" ]; then
		jq -r '.notes // .login.password // empty' <<<"$item_json"
	else
		jq -r '.login.password // (.fields[0].value) // .notes // empty' <<<"$item_json"
	fi
}

# --- Step 1: WireGuard VPN --------------------------------------------------

import_wg_conf() {
	local name="$1" content="$2"
	local tmpdir="/dev/shm"
	[ -d "$tmpdir" ] || tmpdir="/tmp"
	local tmp="$tmpdir/$name.conf"
	(
		umask 077
		printf '%s\n' "$content" >"$tmp"
	)
	trap 'rm -f "$tmp"' RETURN
	sudo nmcli connection delete "$name" >/dev/null 2>&1 || true
	sudo nmcli connection import type wireguard file "$tmp"
	if confirm "Connect to '$name' now?" "Y"; then
		nmcli connection up "$name"
	fi
}

setup_vpn() {
	log "WireGuard Home VPN"
	local existing
	existing="$(nmcli -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null | awk -F: '$2 == "wireguard" {print $1 " (active: " $3 ")"}' || true)"
	if [ -n "$existing" ]; then
		info "Existing WireGuard connection(s): $existing"
		if ! confirm "Configure or replace a WireGuard connection?" "N"; then
			return 0
		fi
	elif ! confirm "Set up a WireGuard VPN connection?" "Y"; then
		return 0
	fi

	echo
	echo "How would you like to provide the WireGuard configuration?"
	echo "  1) Enter connection details interactively (prompts for endpoint, IPs & keys)"
	echo "  2) Import an existing WireGuard .conf file"
	echo "  3) Import a WireGuard .conf from a Bitwarden item/note"
	local mode
	mode="$(ask "Choice (1-3)" "1")"

	case "$mode" in
	2)
		local path name
		path="$(ask "Path to WireGuard .conf file")"
		path="${path/#\~/$HOME}"
		[ -f "$path" ] || die "File not found: $path"
		name="$(basename "$path" .conf)"
		import_wg_conf "$name" "$(cat "$path")"
		;;
	3)
		local name query conf
		name="$(ask "Interface / connection name (max 15 chars)" "wg0")"
		query="$(ask "Bitwarden search term for your WireGuard config" "wireguard")"
		conf="$(bw_fetch "$query" notes)" || die "Could not fetch WireGuard config from Bitwarden"
		[ -n "$conf" ] || die "Bitwarden item was empty"
		import_wg_conf "$name" "$conf"
		;;
	*)
		local name endpoint address dns search allowed peer_pub priv_key psk
		name="$(ask "Interface / connection name (max 15 chars)" "wg0")"
		endpoint="$(ask "Server Endpoint (host:port, e.g. vpn.example.com:51820)")"
		[ -n "$endpoint" ] || die "Endpoint is required"
		address="$(ask "Client IPv4 CIDR (e.g. 10.8.0.2/24)")"
		[ -n "$address" ] || die "Client IPv4 CIDR is required"
		dns="$(ask "VPN DNS server (optional, e.g. 10.8.0.1)" "")"
		search=""
		if [ -n "$dns" ]; then
			search="$(ask "VPN DNS search domain (so aipro.lan resolves)" "lan")"
		fi
		allowed="$(ask "AllowedIPs (home LAN split-tunnel or 0.0.0.0/0)" "10.0.0.0/8, 192.168.0.0/16")"
		peer_pub="$(ask "Server (Peer) PublicKey")"
		[ -n "$peer_pub" ] || die "Server PublicKey is required"

		echo "Client PrivateKey: paste it, type 'bw' to fetch from Bitwarden, or press Enter to generate a new keypair."
		read -rsp "Client PrivateKey: " priv_key
		echo
		if [ "$priv_key" = "bw" ]; then
			local query
			query="$(ask "Bitwarden search term" "wireguard")"
			priv_key="$(bw_fetch "$query" secret)" || die "Could not fetch PrivateKey from Bitwarden"
		elif [ -z "$priv_key" ]; then
			priv_key="$(wg genkey)"
			info "Generated new client PublicKey (add this to your WireGuard server):"
			printf '    \033[1;32m%s\033[0m\n' "$(printf '%s' "$priv_key" | wg pubkey)"
		fi

		read -rsp "PresharedKey (optional; press Enter for none): " psk
		echo

		local dns_line="" psk_line=""
		if [ -n "$dns" ]; then
			dns_line="DNS = ${dns}${search:+, $search}"
		fi
		if [ -n "$psk" ]; then
			psk_line="PresharedKey = $psk"
		fi

		local conf
		conf="[Interface]
Address = $address
PrivateKey = $priv_key
${dns_line:+$dns_line
}
[Peer]
PublicKey = $peer_pub
${psk_line:+$psk_line
}Endpoint = $endpoint
AllowedIPs = $allowed
PersistentKeepalive = 25"
		import_wg_conf "$name" "$conf"
		;;
	esac
}

# --- Step 2: Noctalia AI Agent (aipro.lan) ----------------------------------

detect_model() {
	local host="$1" token="$2"
	local args=(-fsS --max-time 5 -H "Accept: application/json")
	if [ -n "$token" ]; then
		args+=(-H "Authorization: Bearer $token")
	fi
	curl "${args[@]}" "$host/models" 2>/dev/null |
		jq -r '.data[0].id // empty' 2>/dev/null || true
}

setup_agent() {
	log "Noctalia AI Agent"
	if [ -f "$AGENT_CONFIG" ]; then
		local cur_host cur_model
		cur_host="$(jq -r '.host // "?"' "$AGENT_CONFIG" 2>/dev/null || echo "?")"
		cur_model="$(jq -r '.model // "?"' "$AGENT_CONFIG" 2>/dev/null || echo "?")"
		info "Current config: $cur_host ($cur_model)"
		if ! confirm "Reconfigure the AI agent?" "N"; then
			return 0
		fi
	elif ! confirm "Configure the Noctalia AI agent ($DEFAULT_AGENT_HOST)?" "Y"; then
		return 0
	fi

	local host token detected model
	host="$(ask "Host URL" "$DEFAULT_AGENT_HOST")"
	host="${host%/}"

	echo "API token: paste it, type 'bw' to fetch from Bitwarden, or press Enter if not required."
	read -rsp "API token: " token
	echo
	if [ "$token" = "bw" ]; then
		local query
		query="$(ask "Bitwarden search term" "aipro")"
		token="$(bw_fetch "$query" secret)" || die "Could not fetch token from Bitwarden"
	fi

	info "Probing $host/models..."
	detected="$(detect_model "$host" "$token")"
	if [ -n "$detected" ]; then
		info "Detected model on server: $detected"
	else
		info "Could not reach $host/models right now; defaulting model name to 'local'."
		detected="local"
	fi
	model="$(ask "Model name" "$detected")"

	(
		umask 077
		mkdir -p "$AGENT_DATA_DIR"
		jq -n \
			--arg provider "openai" \
			--arg host "$host" \
			--arg model "$model" \
			--arg token "$token" \
			'{provider: $provider, host: $host, model: $model, token: $token}' >"$AGENT_CONFIG"
	)
	info "Saved agent config to $AGENT_CONFIG (open with Mod+A)."
}

# --- Step 3: Dotfiles (clone & stow) ----------------------------------------

ensure_repo() {
	if [ ! -d "$DOTFILES/.git" ]; then
		info "Cloning $REPO_HTTPS into $DOTFILES"
		git clone "$REPO_HTTPS" "$DOTFILES"
	fi
}

# Ensure stowing and pairing tools are available.
install_tools() {
	if [ -x "$BREW" ]; then
		eval "$("$BREW" shellenv)"
	fi
	local tool
	for tool in stow jq qrencode; do
		command -v "$tool" >/dev/null && continue
		{ command -v brew >/dev/null && brew install "$tool" </dev/null; } ||
			warn "could not install $tool"
	done
}

# Move aside anything stow would refuse to replace.
clear_stow_conflicts() {
	local pkg="$1" file rel target
	while IFS= read -r -d '' file; do
		rel="${file#"$DOTFILES/$pkg/"}"
		target="$HOME/$rel"
		if [ -L "$target" ]; then
			[ "$(realpath "$target" 2>/dev/null)" = "$(realpath "$file")" ] || backup "$target"
		elif [ -e "$target" ]; then
			backup "$target"
		fi
	done < <(git -C "$DOTFILES" ls-files -z -- "$pkg" | while IFS= read -r -d '' f; do printf '%s\0' "$DOTFILES/$f"; done)
}

# GNU stow when available, otherwise the bundled stowsh. Both link file by file.
stow_packages() {
	local pkg
	command -v stow >/dev/null || info "stow not found; using $DOTFILES/stowsh"
	for pkg in "${STOW_PACKAGES[@]}"; do
		info "Stowing $pkg"
		clear_stow_conflicts "$pkg"
		if command -v stow >/dev/null; then
			stow --no-folding -d "$DOTFILES" -t "$HOME" -R "$pkg"
		else
			bash "$DOTFILES/stowsh" -s -g -t "$HOME" "$DOTFILES/$pkg" 2>/dev/null
		fi
	done
}

use_ssh_remote() {
	[ -d "$DOTFILES/.git" ] || return 0
	local current
	current="$(git -C "$DOTFILES" remote get-url origin 2>/dev/null || true)"
	if [ "$current" = "$REPO_HTTPS" ] && compgen -G "$HOME/.ssh/id_*" >/dev/null; then
		git -C "$DOTFILES" remote set-url origin "$REPO_SSH"
		info "Switched $DOTFILES remote to $REPO_SSH"
	fi
}

setup_dotfiles() {
	log "Dotfiles ($REPO_HTTPS)"
	if ! confirm "Clone and stow dotfiles into $HOME?" "Y"; then
		return 0
	fi
	ensure_repo
	install_tools
	stow_packages
	use_ssh_remote
}

# --- Step 4: Syncthing & synced folders -------------------------------------

st() {
	local method="$1" path="$2"
	shift 2
	curl -fsS -X "$method" -H "X-API-Key: $ST_KEY" -H "Content-Type: application/json" "$ST_URL$path" "$@"
}

start_syncthing() {
	info "Starting Syncthing"
	mkdir -p "$SYNC_ROOT"
	systemctl --user daemon-reload
	systemctl --user start syncthing.service

	local _
	ST_KEY=""
	for _ in $(seq 180); do
		if [ -f "$ST_CONFIG" ]; then
			ST_KEY="$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$ST_CONFIG")"
			if [ -n "$ST_KEY" ] && st GET /rest/system/ping >/dev/null 2>&1; then
				return
			fi
		fi
		sleep 1
	done
	die "Syncthing API did not come up; check: systemctl --user status syncthing"
}

folder_id() {
	st GET /rest/config/folders | jq -r --arg label "$1" '[.[] | select(.label == $label)][0].id // empty'
}

missing_folders() {
	local label
	for label in "${SYNC_FOLDERS[@]}"; do
		[ -n "$(folder_id "$label")" ] || printf '%s\n' "$label"
	done
}

# Accept devices that connect after scanning our QR code. Accepted devices act
# as introducers and their shared folders are accepted automatically.
accept_pending_devices() {
	local pending id name rc
	pending="$(st GET /rest/cluster/pending/devices)"
	for id in $(jq -r 'keys[]' <<<"$pending"); do
		[ -n "${ASKED[$id]:-}" ] && continue
		ASKED[$id]=1
		name="$(jq -r --arg id "$id" '.[$id].name // "unnamed"' <<<"$pending")"
		rc=0
		confirm_tty "Device \"$name\" ($id) wants to connect. Accept it?" || rc=$?
		if [ "$rc" = 0 ]; then
			st PUT "/rest/config/devices/$id" \
				-d "$(jq -n --arg id "$id" --arg name "$name" \
					'{deviceID: $id, name: $name, introducer: true, autoAcceptFolders: true}')" >/dev/null
			info "Accepted $name; waiting for it to share ${SYNC_FOLDERS[*]}"
		elif [ "$rc" = 2 ]; then
			info "Accept \"$name\" at $ST_URL, ticking \"Introducer\" and \"Auto Accept\""
		else
			info "Ignored $name"
		fi
	done
}

pair_syncthing() {
	local missing
	missing="$(missing_folders)"
	[ -z "$missing" ] && return
	# Auto-accepted folders go to <default path>/<label>.
	st PATCH /rest/config/defaults/folder -d '{"path": "~"}' >/dev/null
	local my_id
	my_id="$(st GET /rest/system/status | jq -r .myID)"
	info "In the Syncthing app on your phone, add a device and scan this code:"
	qrencode -t ansiutf8 "$my_id"
	info "Then share these folders with it: ${SYNC_FOLDERS[*]}"
	declare -gA ASKED=()
	while [ -n "$missing" ]; do
		accept_pending_devices
		sleep 3
		missing="$(missing_folders)"
	done
}

wait_for_sync() {
	local label fid status state global need line last=""
	info "Waiting for the folders to sync (Ctrl-C is safe; re-run to resume)..."
	for label in "${SYNC_FOLDERS[@]}"; do
		fid="$(folder_id "$label")"
		while :; do
			status="$(st GET "/rest/db/status?folder=$fid" 2>/dev/null || echo '{}')"
			state="$(jq -r '.state // "unknown"' <<<"$status")"
			global="$(jq -r '.globalTotalItems // 0' <<<"$status")"
			need="$(jq -r '.needTotalItems // 0' <<<"$status")"
			if [ "$state" = idle ] && [ "$global" -gt 0 ] && [ "$need" -eq 0 ]; then
				info "$label is in sync ($global items)"
				break
			fi
			if [ "$global" -eq 0 ]; then
				line="$label: waiting for data"
			else
				line="$label: $state, $need of $global items left"
			fi
			[ "$line" != "$last" ] && info "$line" && last="$line"
			sleep 5
		done
	done
}

link_synced() {
	local entry src dst
	for entry in "${SYNC_LINKS[@]}"; do
		src="$SYNC_ROOT/${entry%%:*}"
		dst="$HOME/${entry#*:}"
		if [ ! -e "$src" ]; then
			warn "$src does not exist; not linking $dst"
			continue
		fi
		[ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ] && continue
		if [ -e "$dst" ] || [ -L "$dst" ]; then
			backup "$dst"
		fi
		mkdir -p "$(dirname "$dst")"
		ln -s "$src" "$dst"
		info "Linked $dst -> $src"
		case "$dst" in
		"$HOME/.ssh" | "$HOME/.gnupg") chmod 700 "$src" ;;
		esac
	done
	if command -v gpgconf >/dev/null; then
		gpgconf --kill gpg-agent 2>/dev/null || true
	fi
}

setup_syncthing() {
	log "Syncthing (${SYNC_FOLDERS[*]})"
	if ! confirm "Set up Syncthing and link synced folders?" "Y"; then
		return 0
	fi
	install_tools
	if [ "${SKIP_SYNC:-0}" = 1 ]; then
		info "Skipping Syncthing pairing (SKIP_SYNC=1)"
	else
		start_syncthing
		pair_syncthing
		wait_for_sync
	fi
	link_synced
	use_ssh_remote
}

# --- Step 5: Packages (Homebrew bundle, mise, Neovim) -----------------------

# The slow installs; in `all` mode they run while Syncthing syncs. Failures only warn.
install_packages() {
	if [ -x "$BREW" ]; then
		eval "$("$BREW" shellenv)"
	fi

	if [ "${SKIP_BREW:-0}" = 1 ]; then
		info "Skipping brew bundle"
	elif command -v brew >/dev/null; then
		info "Installing ~/.Brewfile"
		brew bundle --global </dev/null ||
			warn "brew bundle reported failures; continuing"
	else
		warn "Homebrew not found at $BREW; skipping brew bundle"
	fi

	if [ "${SKIP_MISE:-0}" = 1 ]; then
		info "Skipping mise install"
	elif command -v mise >/dev/null; then
		info "Installing mise tools from ~/.config/mise/config.toml"
		(cd "$HOME" && mise install --yes </dev/null) ||
			warn "mise install reported failures; continuing"
	else
		warn "mise not found; skipping mise install"
	fi

	if command -v nvim >/dev/null; then
		info "Installing Neovim plugins"
		nvim --headless +qa </dev/null || warn "Neovim plugin install failed; continuing"
	else
		warn "nvim not found; skipping Neovim plugins"
	fi
}

setup_packages() {
	log "Packages (Homebrew bundle, mise, Neovim)"
	if ! confirm "Install Homebrew bundle, mise tools, and Neovim plugins?" "Y"; then
		return 0
	fi
	install_packages
}

setup_syncthing_and_packages() {
	local do_sync=0 do_pkgs=0
	log "Syncthing (${SYNC_FOLDERS[*]})"
	if [ "${SKIP_SYNC:-0}" = 1 ]; then
		info "Skipping Syncthing pairing (SKIP_SYNC=1)"
	elif confirm "Set up Syncthing and link synced folders?" "Y"; then
		do_sync=1
	fi

	log "Packages (Homebrew bundle, mise, Neovim)"
	if confirm "Install Homebrew bundle, mise tools, and Neovim plugins?" "Y"; then
		do_pkgs=1
	fi

	if [ "$do_sync" -eq 1 ]; then
		install_tools
		start_syncthing
		pair_syncthing
	fi
	if [ "$do_pkgs" -eq 1 ]; then
		install_packages
	fi
	if [ "$do_sync" -eq 1 ]; then
		wait_for_sync
		link_synced
		use_ssh_remote
	elif [ "${SKIP_SYNC:-0}" = 1 ]; then
		link_synced
		use_ssh_remote
	fi
}

# --- Entrypoint -------------------------------------------------------------

main() {
	local step="${1:-all}"
	case "$step" in
	all)
		setup_vpn
		setup_agent
		setup_dotfiles
		setup_syncthing_and_packages
		log "All done! Log out and back in to pick up the new shell config, or press Mod+A to open the agent."
		;;
	vpn)
		setup_vpn
		;;
	agent)
		setup_agent
		;;
	dotfiles)
		setup_dotfiles
		;;
	syncthing)
		setup_syncthing
		;;
	packages)
		setup_packages
		;;
	*)
		echo "usage: ujust blueme [all|vpn|agent|dotfiles|syncthing|packages]" >&2
		exit 2
		;;
	esac
}

[ "${BLUEME_NO_MAIN:-0}" = 1 ] || main "$@"
