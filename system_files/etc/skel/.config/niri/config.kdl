// Default Niri configuration shipped to every new user via /etc/skel.
// Users are free to copy and edit this at ~/.config/niri/config.kdl.

input {
    keyboard {
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
}

output "*" {
    scale 1.0
}

// Ask apps to drop their own title bars and window borders (client-side
// decorations); Niri draws none of its own beyond the focus ring.
prefer-no-csd

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
    }
}

// Launch the Noctalia shell (bar, launcher, notifications, control center,
// wallpaper, lock screen) as soon as the compositor starts.
spawn-at-startup "noctalia"

// Fallback wallpaper daemon; Noctalia manages the wallpaper once running,
// this just avoids a flash of empty background before it is ready.
spawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/madeofblue/madeofblue.jpeg" "-m" "fill" "-c" "#1d1f21"

// Polkit authentication agent, needed for GUI privilege-escalation prompts.
spawn-at-startup "lxpolkit"

// Mod is Super. Mod+K lists these bindings on screen.
binds {
    // ── Shell ────────────────────────────────────────────────────────────────
    Mod+K { show-hotkey-overlay; }
    Mod+Shift+Slash hotkey-overlay-title=null { show-hotkey-overlay; }
    Mod+Space hotkey-overlay-title="App launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Escape hotkey-overlay-title="Session menu (lock, log out, power)" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+Space hotkey-overlay-title="Show or hide the bar" { spawn "noctalia" "msg" "bar-toggle"; }
    Mod+Ctrl+Space hotkey-overlay-title="Wallpaper picker" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Ctrl+Shift+Space hotkey-overlay-title="Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Ctrl+T hotkey-overlay-title="Toggle light/dark theme" { spawn "noctalia" "msg" "theme-mode-toggle"; }
    Mod+Ctrl+V hotkey-overlay-title="Clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Ctrl+E hotkey-overlay-title="Emoji picker" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }
    Mod+A hotkey-overlay-title="Agent" { spawn "noctalia" "msg" "panel-toggle" "madeofblue/agent:chat"; }
    Mod+Shift+L hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Control-center pages
    Mod+Ctrl+A hotkey-overlay-title="Audio" { spawn "noctalia" "msg" "panel-toggle" "control-center" "audio"; }
    Mod+Ctrl+B hotkey-overlay-title="Bluetooth" { spawn "noctalia" "msg" "panel-toggle" "control-center" "bluetooth"; }
    Mod+Ctrl+N hotkey-overlay-title="Network" { spawn "noctalia" "msg" "panel-toggle" "control-center" "network"; }
    Mod+Ctrl+Alt+D hotkey-overlay-title="Calendar" { spawn "noctalia" "msg" "panel-toggle" "control-center" "calendar"; }
    Mod+Ctrl+I hotkey-overlay-title="Keep awake (toggle idle lock)" { spawn "noctalia" "msg" "caffeine-toggle"; }

    // Notifications
    Mod+Comma hotkey-overlay-title="Open latest notification" { spawn "noctalia" "msg" "notification-invoke-latest"; }
    Mod+Shift+Comma hotkey-overlay-title="Dismiss all notifications" { spawn "noctalia" "msg" "notification-clear-active"; }
    Mod+Shift+Alt+Comma hotkey-overlay-title="Notification history" { spawn "noctalia" "msg" "panel-toggle" "control-center" "history"; }
    Mod+Ctrl+Alt+Comma hotkey-overlay-title="Toggle do not disturb" { spawn "noctalia" "msg" "notification-dnd-toggle"; }

    // ── Apps ─────────────────────────────────────────────────────────────────
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+Shift+F hotkey-overlay-title="File manager" { spawn "nautilus" "--new-window"; }
    Mod+Shift+N hotkey-overlay-title="Editor" { spawn "code"; }
    Mod+Shift+T hotkey-overlay-title="Activity monitor" { spawn "foot" "htop"; }

    // ── Windows ──────────────────────────────────────────────────────────────
    Mod+W { close-window; }
    Mod+Q hotkey-overlay-title=null { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Alt+F { maximize-column; }
    Mod+Ctrl+F hotkey-overlay-title="Fullscreen inside its tile" { toggle-windowed-fullscreen; }
    Mod+T { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Switch focus between floating and tiled" { switch-focus-between-floating-and-tiling; }
    Mod+O { toggle-overview; }
    Mod+R { switch-preset-column-width; }
    Mod+C { center-column; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }
    Alt+Tab hotkey-overlay-title="Window switcher" { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Alt+Shift+Tab hotkey-overlay-title=null { spawn "noctalia" "msg" "window-switcher" "hold" "reverse"; }

    // Move
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }

    // Stack windows in a column, and show a column as tabs
    Mod+Alt+Left  { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }
    Mod+Alt+Up    hotkey-overlay-title=null { focus-window-up; }
    Mod+Alt+Down  hotkey-overlay-title=null { focus-window-down; }
    Mod+G { toggle-column-tabbed-display; }

    // Resize (Minus/Equal: column width; with Shift: window height;
    // with Alt: a little; with Ctrl: a lot)
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Alt+Minus  hotkey-overlay-title=null { set-column-width "-2%"; }
    Mod+Alt+Equal  hotkey-overlay-title=null { set-column-width "+2%"; }
    Mod+Ctrl+Minus hotkey-overlay-title=null { set-column-width "-25%"; }
    Mod+Ctrl+Equal hotkey-overlay-title=null { set-column-width "+25%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+Alt+Minus  hotkey-overlay-title=null { set-window-height "-2%"; }
    Mod+Shift+Alt+Equal  hotkey-overlay-title=null { set-window-height "+2%"; }
    Mod+Shift+Ctrl+Minus hotkey-overlay-title=null { set-window-height "-25%"; }
    Mod+Shift+Ctrl+Equal hotkey-overlay-title=null { set-window-height "+25%"; }
    Mod+Shift+R hotkey-overlay-title="Reset window height" { reset-window-height; }

    // ── Workspaces ───────────────────────────────────────────────────────────
    // Mod+N: go to workspace N; with Shift: take the window along;
    // with Shift+Alt: send the window without following it.
    Mod+1 hotkey-overlay-title=null { focus-workspace 1; }
    Mod+Shift+1 hotkey-overlay-title=null { move-column-to-workspace 1; }
    Mod+Shift+Alt+1 hotkey-overlay-title=null { move-column-to-workspace 1 focus=false; }
    Mod+2 hotkey-overlay-title=null { focus-workspace 2; }
    Mod+Shift+2 hotkey-overlay-title=null { move-column-to-workspace 2; }
    Mod+Shift+Alt+2 hotkey-overlay-title=null { move-column-to-workspace 2 focus=false; }
    Mod+3 hotkey-overlay-title=null { focus-workspace 3; }
    Mod+Shift+3 hotkey-overlay-title=null { move-column-to-workspace 3; }
    Mod+Shift+Alt+3 hotkey-overlay-title=null { move-column-to-workspace 3 focus=false; }
    Mod+4 hotkey-overlay-title=null { focus-workspace 4; }
    Mod+Shift+4 hotkey-overlay-title=null { move-column-to-workspace 4; }
    Mod+Shift+Alt+4 hotkey-overlay-title=null { move-column-to-workspace 4 focus=false; }
    Mod+5 hotkey-overlay-title=null { focus-workspace 5; }
    Mod+Shift+5 hotkey-overlay-title=null { move-column-to-workspace 5; }
    Mod+Shift+Alt+5 hotkey-overlay-title=null { move-column-to-workspace 5 focus=false; }
    Mod+6 hotkey-overlay-title=null { focus-workspace 6; }
    Mod+Shift+6 hotkey-overlay-title=null { move-column-to-workspace 6; }
    Mod+Shift+Alt+6 hotkey-overlay-title=null { move-column-to-workspace 6 focus=false; }
    Mod+7 hotkey-overlay-title=null { focus-workspace 7; }
    Mod+Shift+7 hotkey-overlay-title=null { move-column-to-workspace 7; }
    Mod+Shift+Alt+7 hotkey-overlay-title=null { move-column-to-workspace 7 focus=false; }
    Mod+8 hotkey-overlay-title=null { focus-workspace 8; }
    Mod+Shift+8 hotkey-overlay-title=null { move-column-to-workspace 8; }
    Mod+Shift+Alt+8 hotkey-overlay-title=null { move-column-to-workspace 8 focus=false; }
    Mod+9 hotkey-overlay-title=null { focus-workspace 9; }
    Mod+Shift+9 hotkey-overlay-title=null { move-column-to-workspace 9; }
    Mod+Shift+Alt+9 hotkey-overlay-title=null { move-column-to-workspace 9 focus=false; }
    Mod+Tab       { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Ctrl+Tab  { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // ── Monitors ─────────────────────────────────────────────────────────────
    Ctrl+Alt+Tab       { focus-monitor-next; }
    Ctrl+Alt+Shift+Tab { focus-monitor-previous; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Alt+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Up    { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down  { move-workspace-to-monitor-down; }

    // ── Screenshots ──────────────────────────────────────────────────────────
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Shift+Print { screenshot-window; }

    // ── Media keys (also work on the lock screen) ────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "keyboard-backlight-up"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "keyboard-backlight-down"; }
    XF86KbdLightOnOff     allow-when-locked=true { spawn "noctalia" "msg" "keyboard-backlight-toggle"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
}
